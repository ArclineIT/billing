# Copy to .env and fill in your values. Never commit the real .env.
# Loaded automatically in development and test via dotenv-rails.

# --- Server ---
# Puma reads PORT (default 3000; the original Go service used 8082).
PORT=8082
# Public base URL, used for mailer links and Stripe redirects.
BASE_URL=https://client.arcline.it
# SQLite database file path (absolute or relative to the app root).
DATABASE_PATH=storage/production.sqlite3

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MANAGED_SECURITY=price_...

# --- SMTP (password reset email) ---
SMTP_HOST=mail.spacemail.com
SMTP_PORT=587
SMTP_USER=blake@arcline.it
SMTP_PASS=
SMTP_FROM=support@arcline.it
